# Copy to .env at repository root. Never commit real secrets.
DATABASE_URL=postgresql://yengfx:local_only_change_me@127.0.0.1:5432/yengfx?schema=public
# Supabase: replace DATABASE_URL privately with the project Connect -> Session
# pooler connection (port 5432), URL-encode its password and append
# ?schema=public&sslmode=require&sslaccept=strict&connection_limit=3
# Never put a database password or service-role key in browser JavaScript.
APP_ORIGIN=http://127.0.0.1:3000
# Only for local scaffolding; reset links go to .local-mail/ (server only).
DEV_EMAIL_OUTBOX=false
# Server-only Resend delivery. Verify a sender domain before enabling.
RESEND_API_KEY=
# Example: YENGFX HUB <account@your-verified-domain.com>
RESEND_FROM=
# Legacy reset sender fallback, retained for existing installations.
RESET_EMAIL_FROM=
# Emails to members after committed admin approval/rejection/revocation.
# Set locally before pnpm db:seed. Never use these accounts in production.
DEMO_MEMBER_PASSWORD=
DEMO_ADMIN_PASSWORD=
# Optional local-only username setup for an existing ADMIN (never commit values).
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
# Read-only MT5 history, disabled until provider setup and database migration.
# Server-only MetaApi API-access token. Never use an account token/client token.
BROKER_READ_ONLY_ENABLED=false
METAAPI_TOKEN=
METAAPI_REGION=new-york
# Enable real-account history only after genuine demo investor-access validation.
METAAPI_ALLOW_REAL_READONLY=false
# Owner-hosted read-only PC connector. Setup script registers its device identity.
PC_CONNECTOR_ENABLED=false
PC_CONNECTOR_ID=
# Keep false until a real demo investor-password test passes. Orders are never supported.
PC_CONNECTOR_ALLOW_REAL_READONLY=false
# USD economic calendar. Leave empty until a licensed provider adapter is registered
# in apps/web/server/news-routes.js. Forex Factory is a reference link only; do not scrape it.
NEWS_PROVIDER=
NEWS_PAUSE_BEFORE_MINUTES=30
NEWS_RESUME_AFTER_MINUTES=30
NEWS_MAX_FEED_AGE_MINUTES=60

# Days of full access for new members (default 90). 0 turns the free trial off.
# MEMBER_TRIAL_DAYS=90
