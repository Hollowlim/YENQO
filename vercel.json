{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm db:generate",
  "outputDirectory": "apps/web/public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{apps/web/templates,apps/web/pages,apps/web/public,prisma}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
